#ifndef DUNGEONCOLONY_ROCK_CUT_INCLUDED
#define DUNGEONCOLONY_ROCK_CUT_INCLUDED

// **벽을 수평면 하나로 자른다**(2026-09-07).
//
// 벽을 24m로 올리자 굴은 깊어졌는데 **비스듬한 카메라에서 앞쪽 벽이 뒤를 통째로 가린다.**
// 답은 높이를 도로 내리는 것이 아니라 **위를 잘라 내는 것**이다.
//
// ── 반경으로 잡았다가 접었다 ──────────────────────────────────────────────
//
// 처음에는 *카메라에서 가까울수록 낮게*로 만들었다(반경 → 허용 높이). 규칙으로는 맞는데
// **화면에서 어지러웠다**(사용자, 두 번). 트인 자리가 **카메라를 따라다니는 웅덩이**라
// 조금만 움직여도 눈앞의 벽이 오르내린다 — 띠를 여섯 배로 넓혀도 그대로였다.
// **움직이는 것 자체가 문제**였지 넓이가 아니었다.
//
// 그래서 **평면 하나**다(사용자: *"원이 아니라 직각으로 다같이 내려가면 좋겠는데"*).
// 화면 전체가 같은 높이에서 잘리므로 **패닝으로는 아무것도 안 변한다** — 변하는 것은
// 줌뿐이고, 그건 **일부러 하는 조작**이라 어지럽지 않다.
//
// 딸려 오는 것 셋:
//   · **뚜껑이 정확히 맞는다** — 잘리는 높이가 자리를 안 타니 윗면과 자른 선이 한 값이다.
//     반경일 때는 둘이 다른 거리를 봐서 어긋났고, 그걸 메우려고 편향을 두어야 했다.
//   · **깊이가 줌에 붙는다** — 당기면 벽이 낮아져 내려다보이고, 물리면 24m 협곡이 돌아온다.
//   · **한 프레임에 상수 하나** — 자리마다 셈할 것이 없다.
//
// **꺼져 있으면 한 줄도 안 바뀐다** — `_RockCutOn`이 0이면 그대로 돌려준다. 유니폼을
// 아무도 안 밀었을 때(에디터 씬 뷰)도 그래서 안전하다.

float _RockCutOn;        // 0이면 기능 자체가 꺼진다
float _RockCutLow;       // 아무리 당겨도 벽은 이만큼 남는다 (m, 바닥에서)
float _RockCutFrac;      // 눈높이의 이만큼에서 자른다 (0~1)
float _RockCutFloorY;    // 바닥 높이 (m). 지하 바닥은 거의 평지라 한 값으로 족하다

// 자르는 높이 — **눈높이의 비율이다**(2026-09-07에 고정 오프셋에서 바꿨다).
//
// *"눈에서 몇 미터 아래"*로 두었더니 **줌에 따라 뜻이 완전히 달라졌다**: 가까이서는
// 바닥에 눌려 아무리 키워도 더 안 내려가고, 물러나면 40m를 빼도 벽이 여전히 눈앞을 막는다
// (사용자: *"전혀 안 낮아지는데"*). 화면에서 벽이 얼마나 가리는지는 **절대 높이가 아니라
// 내 눈높이와의 비**가 정한다 — 50m 위에서 14m 벽은 여전히 벽이다.
//
// 비율로 두면 **어느 줌에서나 같은 만큼 트인다.** 0.12면 눈높이의 8분의 1이라, 늘
// 훌쩍 내려다보는 그림이 된다. 그리고 **물러날수록 벽이 높아지므로** 협곡은 그대로
// 돌아온다(눈높이 200m에서 24m = 온전한 벽).
float RockCutPlaneY()
{
    // **위쪽 한계가 없다**(2026-09-07에 걷어냈다). *"이 높이 위로는 안 자른다"*는 손잡이를
    // 뒀었는데 **하는 일이 없었다**: 자르는 면이 벽 꼭대기보다 높아지면 `min`이 아무것도
    // 안 하므로 **벽 높이 자신이 이미 그 한계**다. 손잡이가 하나 더 있으면 다음에 읽는
    // 사람이 *"이건 뭘 하는 값이지"*를 재게 된다.
    float eye = _WorldSpaceCameraPos.y - _RockCutFloorY;

    return _RockCutFloorY + max(eye * _RockCutFrac, _RockCutLow);
}

// **뚜껑보다 옆면이 조금 더 높이 남는다.** 둘 다 같은 값을 보므로 원래 딱 맞지만,
// 부동소수점이 스치는 자리에서 **한 픽셀 틈으로 바닥이 비치는 것**보다는 옆면이 한 뼘
// 삐져나오는 편이 낫다(삐져나온 쪽은 뚜껑에 가려 안 보인다).
static const float kRockCapBias = 0.05;

// 윗면인가(뚜껑이 될 면인가). **양면으로 그리므로 부호를 안 본다.**
bool RockIsCap(float3 n) { return abs(n.y) > 0.5; }

// **옆면을 잘라 낸다 — 칼같이.** 사용자가 바란 것이 *직각*이다: 흐리면 잘린 자리가
// 무늬처럼 읽히고, 그 아른거림이 곧 어지러움이었다.
void RockCutClip(float3 ws, float3 normalWS, float4 positionCS)
{
    if (_RockCutOn < 0.5)
        return;

    // **뚜껑은 안 자른다** — 자르면 덮을 것이 없어져 그 아래 땅바닥이 드러난다
    // (맞닿은 두 바위 사이에는 애초에 면을 안 굽는다 — 드러난 면만 굽는다).
    if (RockIsCap(normalWS))
        return;

    clip(RockCutPlaneY() + kRockCapBias - ws.y);
}

// **등을 보이는 면은 버린다**(2026-09-07, 사용자: *"벽 안에 들어가서 밖을 바라볼 때
// 안쪽에서 바라보는 벽의 텍스쳐가 불투명한 상태로 비쳐서 보인다"*).
//
// 바위는 **양면으로 그린다**(`_Cull Off`) — 면마다 네 모서리를 손으로 적는데 방향에 따라
// 감김이 뒤집혀서, 뒷면 컬링을 켜면 **뒤집힌 면이 통째로 안 그려졌다**(벽이 구멍으로
// 보였다). 그 결정은 맞다 — 감김을 하나씩 맞추는 길은 면을 추가할 때마다 또 틀린다.
//
// 대가는 **바위 속에서 밖을 보면 그 벽의 안쪽 면이 그려지는 것**이다. **감김 대신 법선으로
// 자른다** — 법선은 면마다 정확히 적혀 있으니(윗면 up · 옆면은 이웃 방향) 등진 면을 버리면
// 뒷면 컬링과 같은 결과가 나면서 감김을 안 탄다.
//
// ── 언제 밥값을 하는가 (2026-09-07에 지웠다 되돌렸다) ────────────────────────
//
// 한 번 걷어냈다. 근거는 *"카메라가 바위 속에 들어갈 일이 없다"*였는데 **그 근거가 틀렸다** —
// 진단 로그가 눈높이를 **자르고 남은 벽**과 견주면서 라벨만 *"바위 속인가"*라고 달고 있었다
// (카메라는 실제로 24m 기둥 **속**에 있었다. 사용자: *"아니 지금 바위 속에 있는거야"*).
//
// **다만 자르기가 켜져 있는 동안에는 정말로 하는 일이 없다** — 그려지는 바위는 잘린 면
// 아래뿐이고 카메라는 늘 그 위에 있다. 밥값을 하는 것은 **`eye < cutLow`까지 당겼을 때**다:
// 그때는 자르는 면이 바닥값(2.5m)에 걸려 카메라가 **그려진 벽 속**에 들어간다. `cutLow`가
// 있는 이유가 곧 그만큼 당기는 일이 있다는 뜻이라, **닿을 수 있는 상태다.**

void RockCutBackface(float3 ws, float3 normalWS)
{
    clip(dot(normalWS, _WorldSpaceCameraPos.xyz - ws));
}

// **윗면은 내리고 옆면은 잘라 낸다.**
//
// 한때 *"모든 면을 내린다"*를 손잡이로 같이 뒀는데 **걷어냈다**(2026-09-07). 그쪽은
// UV가 그대로인 채 면만 짧아져 **옆면 무늬가 세로로 눌리고**, 무엇보다 **꺼 두면 자르기가
// 통째로 안 걸린 것처럼 보인다** — 실제로 그 상태를 *"한쪽을 빼먹은 것 아니냐"*로 읽었다.
// **고를 이유가 없는 갈래는 손잡이가 아니라 함정이다.**
//
// **뚜껑 위에 얹은 것은 뜬 만큼을 지킨 채 같이 내려온다**(2026-09-28, 윗면 광맥 — 사용자: *"광물이 박힌 벽 위에도
// 광물이 박혀서 직관적으로 볼 수 있게"*). 알갱이를 뚜껑 위에 얹으면 그 정점도 뚜껑이라(`RockIsCap`) 끌려
// 내려오는데, `min` 하나로는 **전부 자르는 높이 한 평면으로 눌려** 뚜껑과 z-파이팅한다. 그래서 정점마다
// *뚜껑에서 얼마나 떠 있나*(`lift` — 메시의 uv3.x)를 받아 **빼고 내린 뒤 도로 더한다.** 보통 뚜껑은 0이라
// 한 줄도 안 바뀐다.
float3 RockCutWS(float3 ws, float3 normalWS, float lift)
{
    if (_RockCutOn < 0.5 || !RockIsCap(normalWS))
        return ws;   // 옆면은 프래그먼트가 자른다

    ws.y = min(ws.y - lift, RockCutPlaneY()) + lift;
    return ws;
}

// 정점 하나를 물체 공간에서 받아 **자리를 잡기 전에** 내린다 — `GetVertexPositionInputs`
// 앞이어야 화면 좌표·월드 좌표·그림자 좌표가 **한 자리를 가리킨다.**
//
// **`lift`는 패스 셋이 다 받아야 한다**(Forward·DepthOnly·DepthNormals) — 하나라도 빠지면 그 패스만 알갱이를
// 눌러 깊이와 색이 어긋난다(자르기를 패스 셋 전부에 건 것과 같은 규칙).
float3 RockCutOS(float3 positionOS, float3 normalOS, float lift)
{
    float3 ws = TransformObjectToWorld(positionOS);
    return TransformWorldToObject(RockCutWS(ws, normalOS, lift));
}

#endif
